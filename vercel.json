{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(css|js|img|app-assets)/(.*)", "destination": "/public/$1/$2" },
    { "source": "/(admin.html|app.html|manifest.json|sw.js|favicon.ico)", "destination": "/public/$1" },
    { "source": "/(.*)", "destination": "/public/index.html" }
  ]
}
