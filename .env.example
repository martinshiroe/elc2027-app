# Copiez ce fichier en .env pour tester le mode Supabase/GitHub en local (optionnel).
# En production (Render/Railway), ces variables se définissent dans le
# tableau de bord de l'hébergeur — jamais dans un fichier commité.

# --- Supabase (données : compétition, joueurs, classements, Panthéon) ---
# Prioritaire dès qu'il est rempli. URL du projet + clé "service_role"
# (Project Settings → API dans le tableau de bord Supabase — jamais la clé "anon").
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- GitHub (photos toujours ; données en secours si Supabase n'est pas configuré) ---
# Jeton d'accès GitHub (fine-grained), avec permission "Contents: Read and write"
# limitée au dépôt de données ci-dessous.
GITHUB_TOKEN=

# Dépôt GitHub dédié aux données/photos (doit être PUBLIC pour que les photos
# s'affichent sans authentification via raw.githubusercontent.com).
GITHUB_OWNER=
GITHUB_REPO=elc2027-data
GITHUB_BRANCH=main

# Code d'accès à l'interface admin — choisissez une valeur forte et unique.
ADMIN_KEY=
